# Environment: development | production
# development → seeding data dummy (admin, guru, santri, wali, kelas)
# production  → tanpa data dummy (default bila tidak di-set)
APP_ENV=development

# Backend
SERVER_ADDRESS=:8080
DATABASE_URL=postgres://amarwirahadikusuma@localhost:5432/marhotullah_app?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
JWT_SECRET=change-me-super-secret
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000

# MinIO (object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ponpes
MINIO_USE_SSL=false

# Admin awal (khusus production): dibuat hanya jika belum ada user ber-role admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
